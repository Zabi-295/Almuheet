# ========================================================
# Al Muheet Fragrance - Backend Environment Configuration
# Copy this file to .env and configure your local credentials
# ========================================================

# Database Driver: 'mysql' (default for XAMPP & GoDaddy) or 'sqlite' (local zero-config)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=almuheet_db
DB_USER=root
DB_PASS=

# JWT / Token Secret for Admin Authentication
# Change this to a secure random string in production
JWT_SECRET=al_muheet_super_secret_perfume_token_key_2026_xyz987

# Store Details
STORE_NAME="Al Muheet Fragrance"
DEFAULT_CURRENCY="PKR"

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://almuheet.store"
